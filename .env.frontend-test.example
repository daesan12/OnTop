# Local front-end integration only. Copy to .env.frontend-test (Git ignored).
# scripts/start-frontend-test.ps1 loads this file without evaluating its values.
DB_URL=jdbc:mysql://127.0.0.1:3306/ontop_frontend_test?connectionTimeZone=UTC
DB_USERNAME=
DB_PASSWORD=
AUTH_JWT_SECRET_BASE64=
AUTH_JWT_ISSUER=ontop
FRONTEND_ORIGIN=http://localhost:5173
AUTH_FRONTEND_CALLBACK_URI=http://localhost:5173/auth/callback
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=
SSAFY_REDIRECT_URI=http://localhost:8080/api/v1/auth/ssafy/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/api/v1/auth/naver/callback
