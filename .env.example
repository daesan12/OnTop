# 저장소 루트에서 .env로 복사 후 빈 값을 채우세요. 실제 .env는 Git 제외입니다.
# 자동 로딩되지 않습니다. 실행 구성의 환경변수에 지정하세요.
# 두 계정 로컬 연동 실행기는 docs/frontend-integration.md의 별도 환경 파일을 사용합니다.
# 형식: KEY=값 (따옴표·export·줄 끝 주석 없이 작성, # 주석은 별도 줄)

# 로컬 DB/로그인/WebSocket 실행. DB 없이 실행만 확인하려면 local로 변경.
SPRING_PROFILES_ACTIVE=local,db
SERVER_PORT=8080

# Default: true
# false is allowed only in local development.
WEBSOCKET_AUTHENTICATED=true

# local/dev 감정표현 5종. 손 인사·박수 5초, 나머지 1.8초.
# 운영 등록 목록은 배포 설정에서 별도 지정합니다.
WORLD_EMOTE_CODES=WAVE,CLAP,APPLAUSE_REQUEST,TSK,FART

# db 프로필 필수. 먼저 본인 개발용 MySQL DB와 계정을 준비하세요.
DB_URL=jdbc:mysql://127.0.0.1:3306/ontop?connectionTimeZone=UTC
DB_USERNAME=
DB_PASSWORD=

# 로그인/JWT 인증 필수: 안전한 난수 32바이트 이상을 Base64로 인코딩한 값.
# 안전하게 생성하거나 팀에서 별도 경로로 전달받으세요. 실제 키는 커밋하지 않습니다.
AUTH_JWT_SECRET_BASE64=
AUTH_JWT_ISSUER=ontop

# 브라우저 프론트의 실제 origin(스킴+호스트+포트), 여러 개면 쉼표로 구분.
AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 프론트 로그인 완료 화면의 실제 URL. 로그인 연동 시 입력.
AUTH_FRONTEND_CALLBACK_URI=

# HTTP 로컬 개발용. HTTPS 배포에서는 Secure=true와 배포 origin으로 변경.
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth

# 해당 공급자로 로그인할 때 필수. 등록된 앱의 값/콜백 URL과 일치해야 합니다.
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=
SSAFY_REDIRECT_URI=http://localhost:8080/api/v1/auth/ssafy/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/api/v1/auth/naver/callback

# 이 파일만으로 상점/게임 DB가 준비되지는 않습니다.
# 상점의 별도 스키마·활성화: docs/shop-inventory.md 참고. 의상 중복 구매는 서버에서 거절합니다.
# 테스트 DB 변수/시연 계정은 일반 서버 실행에 필요하지 않아 제외했습니다.

# 소리함: V120 순서를 팀과 맞춘 뒤 활성화. 실제 DB 초기화/repair/outOfOrder는 자동 실행하지 않습니다.
# local,db는 ONTOP_FEEDBACK_ENABLED=true, dev,db는 FEEDBACK_ENABLED=true와
# 기존 SPRING_FLYWAY_LOCATIONS 목록에 classpath:db/feedback 추가가 필요합니다.
# 관리자 회원 ID는 쉼표로 구분. 비어 있으면 관리자 조회는 모두 거절됩니다.
FEEDBACK_ENABLED=false
FEEDBACK_ADMINISTRATOR_IDS=

# M08 익명 메모: V121 적용 순서 합의 후 db/notes 경로를 명시적으로 추가합니다.
# dev: NOTES_ENABLED=true / local: ONTOP_NOTES_ENABLED=true (기본 꺼짐)
NOTES_ENABLED=false
# 전 인스턴스 공통 32자 이상 임의 비밀키. 실제 값은 공유/커밋하지 않습니다.
NOTES_PRIVACY_SECRET=
# local에서는 ONTOP_NOTES_PRIVACY_SECRET로 같은 값을 전달합니다.
