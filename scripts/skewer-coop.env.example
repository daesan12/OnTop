# Git 밖에 복사하고 실제 로컬 DB/OAuth 값을 입력한다. start-skewer-coop.ps1만 읽으며 자동 로딩되지 않는다.
DB_URL=jdbc:mysql://127.0.0.1:13386/ontop_skewer_coop_local?connectionTimeZone=UTC
DB_USERNAME=
DB_PASSWORD=
AUTH_JWT_SECRET_BASE64=
AUTH_JWT_ISSUER=ontop-skewer-local
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5244
AUTH_FRONTEND_CALLBACK_URI=http://127.0.0.1:5244/auth/callback
# 재시작/재배포에도 같은 경로를 유지한다. build, tmp, 컨테이너 내부 임시 경로를 사용하지 않는다.
SKEWER_COOP_JOURNAL_PATH=C:/Users/SSAFY/Desktop/OnTop/local-data/skewer-coop
# 실제로 발급받은 공급자 하나 이상만 설정한다. 콜백은 공급자에 정확히 등록해야 한다.
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=
SSAFY_REDIRECT_URI=http://127.0.0.1:19186/api/v1/auth/ssafy/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://127.0.0.1:19186/api/v1/auth/naver/callback
