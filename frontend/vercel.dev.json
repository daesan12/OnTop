{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.on-top.world"
        }
      ],
      "destination": "https://api.on-top.world/api/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "dev.on-top.world"
        }
      ],
      "destination": "https://dev-api.on-top.world/api/:path*"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/onboarding",
      "destination": "/index.html"
    },
    {
      "source": "/park",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/operations",
      "destination": "/index.html"
    },
    {
      "source": "/admin/announcements",
      "destination": "/index.html"
    },
    {
      "source": "/admin/events",
      "destination": "/index.html"
    },
    {
      "source": "/admin/skins",
      "destination": "/index.html"
    },
    {
      "source": "/admin/feedback",
      "destination": "/index.html"
    },
    {
      "source": "/admin/analytics",
      "destination": "/index.html"
    },
    {
      "source": "/admin/wallet-grants",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "VITE_ALKKAGI_ENABLED=true VITE_WARDROBE_OUTFITS=true VITE_SKEWER_COOP_ENABLED=true VITE_PARK_RENEWAL_ENABLED=true VITE_STONE_RUMBLE_ENABLED=true VITE_PARK_BINDINGS_URL=/park-bindings.generated.dev.json pnpm run build:park",
  "outputDirectory": "dist-park"
}
