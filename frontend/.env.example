# Local FE connected to a backend with v5 enabled. Copy to .env.local.
# DEV Vercel: set the same key in the ontop-frontend-dev project's build environment.
# Use v4 to roll back; only enable v5 against a server with V128 and the v5 flag enabled.
VITE_BUNGEOPPANG_RULES_VERSION=v5

# Both completed features are enabled by default. Explicit false disables one at build time.
# The backend also needs ontop.games.onecard.pranks-enabled=true and defense-enabled=true.
VITE_ONECARD_PRANKS=true
VITE_ONECARD_PRANK_DEFENSE=true
VITE_BUNGEOPPANG_RANKINGS=true

# Keep disabled until BE accepts/returns notes.category and its retry contract is verified.
VITE_NOTES_CATEGORIES=false
