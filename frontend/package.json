{
  "name": "ontop-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:bungeoppang": "vite --mode bungeoppang-preview",
    "dev:facilities": "vite --mode facility-preview",
    "dev:frontend-test": "vite --mode frontend-test --host localhost --port 5173 --strictPort",
    "build": "node scripts/publish-rulebooks.mjs && tsc --noEmit && vite build",
    "rulebooks:publish": "node scripts/publish-rulebooks.mjs",
    "assets:rulebooks": "node scripts/prepare-rulebook-art.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:facilities": "playwright test --config playwright.facilities.config.ts",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "check:migration": "node scripts/check-migration-boundary.mjs",
    "assets:chair": "node scripts/prepare-wood-chair.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "meshoptimizer": "1.1.1",
    "sharp": "0.34.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
