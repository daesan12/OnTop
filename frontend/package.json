{
  "name": "ontop-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:entry-news": "vite --config vite.entry-news.config.ts --open /entry-news-preview.html",
    "dev": "vite",
    "dev:alkkagi-park": "vite --config vite.alkkagi-park.config.ts --mode frontend-test --open /alkkagi-park.html?role=red",
    "dev:park": "vite --mode park-integration --host localhost --port 5202 --strictPort",
    "build:park": "node scripts/generate-park-map.mjs && node scripts/export-jumpmap-course.mjs && node scripts/publish-rulebooks.mjs && tsc --noEmit && vite build --mode park-integration --outDir dist-park",
    "dev:layout": "vite --mode layout-preview --host 127.0.0.1 --port 5201 --strictPort",
    "dev:bungeoppang": "vite --mode bungeoppang-preview",
    "dev:facilities": "vite --mode facility-preview",
    "dev:frontend-test": "vite --mode frontend-test --host localhost --port 5173 --strictPort",
    "build": "node scripts/generate-park-map.mjs && node scripts/publish-rulebooks.mjs && tsc --noEmit && vite build",
    "rulebooks:publish": "node scripts/publish-rulebooks.mjs",
    "assets:rulebooks": "node scripts/prepare-rulebook-art.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "dev:tablet": "vite --mode tablet --host localhost --port 5203 --strictPort",
    "build:tablet": "node scripts/publish-rulebooks.mjs && tsc --noEmit && vite build --mode tablet --outDir dist-tablet",
    "test:e2e:tablet": "playwright test --config playwright.tablet.config.ts",
    "test:e2e:tablet:default": "playwright test --config playwright.tablet-default.config.ts",
    "test": "vitest run",
    "test:unit:local": "vitest run --config vitest.local.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:park": "playwright test --config playwright.park.config.ts",
    "test:e2e:omok-feedback": "playwright test --config playwright.omok-feedback.config.ts",
    "test:e2e:omok-new-map": "playwright test --config playwright.omok-new-map.config.ts omok-tablet-qa.spec.ts play-flow.spec.ts",
    "test:e2e:facilities": "playwright test --config playwright.facilities.config.ts",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "check:migration": "node scripts/check-migration-boundary.mjs",
    "assets:chair": "node scripts/prepare-wood-chair.mjs",
    "map:generate": "node scripts/generate-park-map.mjs",
    "map:check": "node scripts/generate-park-map.mjs --check",
    "jumpmap:export": "node scripts/export-jumpmap-course.mjs",
    "jumpmap:check": "node scripts/export-jumpmap-course.mjs --check",
    "test:e2e:jumpmap": "playwright test --config playwright.jumpmap.config.ts",
    "assets:entry": "node scripts/prepare-entry-images.mjs",
    "dev:bungeoppang:v5": "vite --mode bungeoppang-v5-preview",
    "test:e2e:bungeoppang:v5": "playwright test --config playwright.bungeoppang-v5.config.ts",
    "dev:feedback": "vite --mode feedback-preview --host 127.0.0.1 --port 5204 --strictPort --open /feedback-preview.html",
    "test:e2e:browser-guard": "playwright test --config playwright.browser-guard.config.ts",
    "dev:notes": "vite --mode notes-preview --host 127.0.0.1 --port 5205 --strictPort --open /notes-preview.html",
    "test:e2e:notes-preview": "playwright test --config playwright.notes.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "meshoptimizer": "1.1.1",
    "sharp": "0.34.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
