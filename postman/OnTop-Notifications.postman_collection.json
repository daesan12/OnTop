{
  "info": {
    "name": "OnTop Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "소리함 답변·개인 알림함·엽전/의상 뽑기권 보상 발급/수령. 로컬 구현이며 DEV 미배포. V158/V160 번호·순서 확인 전 푸시·공용 DB 적용 보류. 뽑기권은 기존 V157 gacha_inventory 필요. 관리자 발급은 재화 지급 권한, 답변은 운영 권한. 민감 토큰은 개인 변수로만 설정. docs/notifications-api.md 참고."
  },
  "variable": [
    {
      "key": "receiptId",
      "value": ""
    },
    {
      "key": "feedbackVersion",
      "value": "0"
    },
    {
      "key": "replyOperationId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "rewardOperationId",
      "value": ""
    },
    {
      "key": "rewardUserId",
      "value": ""
    },
    {
      "key": "rewardKind",
      "value": "GACHA_TICKET"
    },
    {
      "key": "rewardAmount",
      "value": "1"
    },
    {
      "key": "rewardExpiresAt",
      "value": "2030-01-01T00:00:00Z"
    },
    {
      "key": "rewardNotificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 관리자 소리함 목록·닉네임·최신 버전",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/feedback?limit=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const id=pm.collectionVariables.get('receiptId');const row=pm.response.json().items.find(x=>x.receiptId===id);if(row)pm.collectionVariables.set('feedbackVersion',row.version);}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 운영진 답변·동일 UUID 재시도",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/operations/feedback/{{receiptId}}/replies",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationId\": \"{{replyOperationId}}\",\n  \"text\": \"알려주신 문제를 수정했습니다. 소중한 의견 감사합니다!\",\n  \"status\": \"RESOLVED\",\n  \"expectedVersion\": {{feedbackVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('receiptId'))throw new Error('01 목록에서 답변할 receiptId를 지정하세요.');",
              "if(!pm.collectionVariables.get('replyOperationId'))pm.collectionVariables.set('replyOperationId',pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const x=pm.response.json();pm.collectionVariables.set('notificationId',x.notificationId);pm.collectionVariables.set('feedbackVersion',x.version);}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 작성자 알림 목록·미읽음 개수",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/notifications?limit=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "04 작성자 알림 상세·읽음 변경 없음",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "05 작성자 읽음 처리·상세 반환",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/read",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200)pm.test('읽음 시각',()=>pm.expect(pm.response.json().readAt).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 관리자 처리 상태만 변경·알림 없음",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/admin/operations/feedback/{{receiptId}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"REVIEWING\",\n  \"expectedVersion\": {{feedbackVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200)pm.collectionVariables.set('feedbackVersion',pm.response.json().version);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 지급 관리자 · 개인 보상 발송(동일 UUID 재시도)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/wallet-grants/rewards",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationId\": \"{{rewardOperationId}}\",\n  \"userId\": \"{{rewardUserId}}\",\n  \"kind\": \"{{rewardKind}}\",\n  \"amount\": {{rewardAmount}},\n  \"title\": \"소중한 의견 감사합니다\",\n  \"text\": \"온탑에서 보내는 작은 선물입니다.\",\n  \"expiresAt\": \"{{rewardExpiresAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.collectionVariables.get('rewardOperationId'))pm.collectionVariables.set('rewardOperationId',pm.variables.replaceIn('{{$guid}}')); // 새 보상에는 키를 비우고 실행"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200)pm.collectionVariables.set('rewardNotificationId',pm.response.json().notificationId);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 수신자 본인 · 보상 한 번 수령(재실행 동일 영수증)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/notifications/{{rewardNotificationId}}/claim",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200){const r=pm.response.json();pm.test('요청한 보상 영수증',()=>pm.expect(r.notificationId).to.eql(pm.collectionVariables.get('rewardNotificationId')));pm.test('수령 시각',()=>pm.expect(r.claimedAt).to.be.a('string'));}"
            ]
          }
        }
      ]
    }
  ]
}
