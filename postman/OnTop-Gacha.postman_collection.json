{
  "info": {
    "name": "OnTop Gacha",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "V156·상점 스키마·실제 상품 등록 후 GACHA_ENABLED=true인 검수 환경에서 실행합니다. 실제 엽전을 소비합니다. 새 작업은 해당 operationId 환경변수를 비우고, 응답 유실 재시도는 그대로 유지하세요. DRAW는 직전 조회의 회차를 사용하며 회차 변경이면 권이 소비되지 않습니다. OPEN의 gachaBoxGrade는 실제 보유한 등급(1~4)을 지정합니다. 인증·403·429·타임아웃은 기존 복구키를 유지합니다. 웹 컬렉션 저장·실행과 파일 생성은 별개입니다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "gachaBoxGrade",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 기계·본인 보관함 조회",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/gacha"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('gachaRoundId', pm.response.json().machine.roundId);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 뽑기권 한 장 구매 (100냥)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/gacha/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationId\": \"{{gachaBuyOperationId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('gachaBuyOperationId')) pm.environment.set('gachaBuyOperationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('gachaLastOperationId', pm.response.json().operationId);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 뽑기권 사용",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/gacha/draws",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationId\": \"{{gachaDrawOperationId}}\",\n  \"roundId\": \"{{gachaRoundId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('gachaDrawOperationId')) pm.environment.set('gachaDrawOperationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('gachaLastOperationId', pm.response.json().operationId);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 의상 상자 개봉",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/gacha/boxes/open",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationId\": \"{{gachaOpenOperationId}}\",\n  \"grade\": {{gachaBoxGrade}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('gachaOpenOperationId')) pm.environment.set('gachaOpenOperationId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('gachaLastOperationId', pm.response.json().operationId);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 확정 결과 복구",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/gacha/operations/{{gachaLastOperationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
