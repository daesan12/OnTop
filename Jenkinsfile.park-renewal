// Explicit candidate pipeline: builds and archives only. It never publishes or deploys.
pipeline {
    agent any
    options { skipDefaultCheckout(true); disableConcurrentBuilds(); timestamps(); timeout(time: 120, unit: 'MINUTES') }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script { env.SOURCE_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim() }
            }
        }
        stage('Prepare shared park release') {
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail
node --version
pnpm --version
cd frontend
pnpm install --frozen-lockfile
pnpm run prepare:park-renewal:release
'''
                script {
                    env.PARK_RELEASE_ID = sh(script: "python3 -c 'import json; print(json.load(open(\"frontend/generated/park-renewal/release.json\"))[\"releaseId\"])'", returnStdout: true).trim()
                    if (!(env.PARK_RELEASE_ID ==~ /[0-9a-f]{64}/)) { error('Invalid renewal release ID.') }
                }
            }
        }
        stage('Backend verification and image') {
            steps {
                dir('backend') { sh 'bash ./gradlew --no-daemon test bootJar' }
                sh 'docker build --platform linux/amd64 --tag ontop-park-renewal-candidate:$SOURCE_SHA backend'
            }
        }
        stage('Frontend verification and release build') {
            steps {
                dir('frontend') {
                    sh '''#!/usr/bin/env bash
set -euo pipefail
pnpm run test
VITE_ALKKAGI_ENABLED=true VITE_WARDROBE_OUTFITS=true VITE_SKEWER_COOP_ENABLED=true pnpm run build:park-renewal:release
'''
                }
            }
        }
        stage('Verify release artifacts') {
            steps { sh '''#!/usr/bin/env bash
set -euo pipefail
jar=$(find backend/build/libs -maxdepth 1 -name '*.jar' ! -name '*-plain.jar' | head -n 1)
python3 infra/ci/check_park_renewal.py --source-sha "$SOURCE_SHA" --dist frontend/dist-park-renewal --jar "$jar"
''' }
        }
    }
    post {
        success {
            archiveArtifacts artifacts: "frontend/dist-park-renewal/**,frontend/generated/park-renewal/releases/${env.PARK_RELEASE_ID}/**,backend/build/libs/*.jar,frontend/park-renewal-assets.lock.json", fingerprint: true
        }
    }
}
