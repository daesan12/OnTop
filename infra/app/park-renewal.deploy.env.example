# Prepare outside Git as /etc/ontop/dev-app/park-renewal.deploy.env (root:root, 0600).
# Start from the EXISTING deploy.env. Preserve its app.env, DB secret files, TLS and Nginx paths.
# This example contains only the new/changed keys, not a replacement for the existing file.
BACKEND_IMAGE=wooaw/ontop-backend:sha-REPLACE_WITH_40_HEX_COMMIT
PARK_RENEWAL_SOURCE_SHA=REPLACE_WITH_40_HEX_COMMIT
PARK_RENEWAL_RELEASE_ID=REPLACE_WITH_64_HEX_RELEASE_ID
PARK_RENEWAL_HOST_DIR=/opt/ontop/park-renewal/REPLACE_WITH_64_HEX_RELEASE_ID
SKEWER_COOP_JOURNAL_HOST_DIR=/var/lib/ontop/skewer-coop
