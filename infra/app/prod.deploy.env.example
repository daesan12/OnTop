# Copy outside Git to /etc/ontop/prod-app/deploy.env (root:root, 0600).
# Paths must be absolute and must exist before docker compose up.
APP_ENV_FILE=/etc/ontop/prod-app/app.env
DB_PASSWORD_FILE=/etc/ontop/prod-app/secrets/db-password
NGINX_CONFIG_FILE=/opt/ontop/infra/app/nginx/bootstrap.conf
ACME_WEBROOT_DIR=/srv/ontop/prod-app/acme
TLS_DIR=/etc/ontop/prod-app/tls
# Docker Hub private repository. Replace manual with the image's immutable release tag.
BACKEND_IMAGE=wooaw/ontop-backend:manual
# Coordinated generated-map rollout only. Stage the immutable release first,
# then set the confirmed 64-character mapVersion directory here.
# PARK_MAP_HOST_DIR=/opt/ontop/maps/<confirmed-mapVersion>
