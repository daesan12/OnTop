# Copy outside Git to /etc/ontop/prod-app/app.env (root:root, 0600).
# DB_PASSWORD is read from the Compose secret, not duplicated here.
DB_URL=jdbc:mysql://10.77.0.1:3306/ontop?connectionTimeZone=UTC
DB_USERNAME=ontop_app
AUTH_JWT_SECRET_BASE64=REPLACE_WITH_BASE64_RANDOM_SECRET
AUTH_JWT_ISSUER=ontop-prod
AUTH_ALLOWED_ORIGINS=https://on-top.world,https://www.on-top.world
AUTH_FRONTEND_CALLBACK_URI=https://www.on-top.world/auth/callback
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
WEBSOCKET_AUTHENTICATED=true
BEHAVIOR_LOG_ENABLED=true
FEEDBACK_ENABLED=false
ADMIN_READ_IDS=
SSAFY_CLIENT_ID=REPLACE_WITH_CLIENT_ID
SSAFY_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
SSAFY_REDIRECT_URI=https://www.on-top.world/api/v1/auth/ssafy/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
