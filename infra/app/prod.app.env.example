# Copy outside Git to /etc/ontop/prod-app/app.env (root:root, 0600).
# DB_PASSWORD is read from the Compose secret, not duplicated here.
DB_URL=jdbc:mysql://10.77.0.1:3306/ontop?connectionTimeZone=UTC
DB_USERNAME=ontop_app
AUTH_JWT_SECRET_BASE64=REPLACE_WITH_BASE64_RANDOM_SECRET
AUTH_JWT_ISSUER=ontop-prod
AUTH_ALLOWED_ORIGINS=https://on-top.world,https://www.on-top.world
AUTH_FRONTEND_CALLBACK_URI=https://www.on-top.world/auth/callback
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
WEBSOCKET_AUTHENTICATED=true
BEHAVIOR_LOG_ENABLED=true
# 2026-11-02 09:00 Asia/Seoul. 재배포·재시작 때 바꾸지 않습니다.
PARK_RANKING_STARTED_AT=2026-11-02T00:00:00Z
# Game and content features stay off until DB migrations, runtime dependencies and end-to-end flows are verified.
# For the complete service, enable these only after the production-like validation described in README.md.
GAME_START_ENABLED=false
GAME_ALKKAGI_ENABLED=false
GAME_OMOK_ENABLED=false
GAME_FARKLE_ENABLED=false
GAME_ONECARD_ENABLED=false
GAME_BRIDGE_ENABLED=false
GAME_LEDGER_ENABLED=false
GAME_HALLIGALLI_ENABLED=false
MINIGAMES_ENABLED=false
BUNGEOPPANG_V5_ENABLED=false
WORLD_JUMPMAP_ENABLED=false
SHOP_ENABLED=false
RAFFLE_ENABLED=false
# 첫 주 게임상은 V153과 붕어빵 v5·점프맵 기록이 준비된 뒤 켭니다.
MINIGAME_AWARD_ENABLED=false
# MINIGAME_AWARD_AUTO_ENABLED=true
# MINIGAME_AWARD_WEEK=2026-11-02
# 둘째 주 자산상은 의상 가치를 제외한 마감 시점 엽전 보유량만 사용합니다.
ASSET_AWARD_ENABLED=false
# ASSET_AWARD_AUTO_ENABLED=true
# ASSET_AWARD_WEEK=2026-11-09
NOTES_ENABLED=false
NOTES_PRIVACY_SECRET=
# Keep the existing common location until all installed Flyway versions and optional tables are checked.
# Then add classpath:db/shop,classpath:db/minigame as required, in one reviewed release.
# Anonymous notes tables come from common V133; never add classpath:db/notes or classpath:db/feedback.
DB_MIGRATION_LOCATIONS=classpath:db/migration
# Jira 117: one initial logical channel; new channels appear at 18/20 users.
# Maximum 2 is a provisional server limit. Set the measured value after Jira 119.
WORLD_DYNAMIC_CHANNELS_ENABLED=true
WORLD_CHANNEL_CAPACITY=20
WORLD_CHANNEL_SPAWN_AT=18
WORLD_MAX_CHANNELS=2
WORLD_CHANNEL_IDLE_TIMEOUT=5m
WORLD_EMOTE_CODES=WAVE,CLAP,APPLAUSE_REQUEST,TSK,FART
FEEDBACK_ENABLED=false
ADMIN_READ_IDS=
ADMIN_GRANT_IDS=
# 점검 전환 전용 관리자 ID. 생략하면 ADMIN_GRANT_IDS를 사용합니다.
# ADMIN_OPERATION_IDS=
# 원문 연락처를 볼 GM 내부 회원 ID. ADMIN_READ_IDS에도 포함해야 합니다.
ADMIN_CONTACT_IDS=
# V155 반영 및 키 설정 확인 후 켭니다. 키 원문은 서버 app.env에만 둡니다.
EVENT_CONTACT_ENABLED=false
EVENT_CONTACT_ACTIVE_KEY_ID=
# 형식: key-id=32바이트_Base64. 키 교체 시 이전 키도 쉼표로 이어서 보관합니다.
EVENT_CONTACT_KEYS=
SSAFY_CLIENT_ID=REPLACE_WITH_CLIENT_ID
SSAFY_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
SSAFY_REDIRECT_URI=https://www.on-top.world/api/v1/auth/ssafy/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
