# Copy outside Git to /etc/ontop/dev-app/app.env (root:root, 0600).
# DB_PASSWORD is read from the same Compose secret used by dev MySQL.
# 기존 서버에서는 파일 전체를 덮어쓰지 말고 누락 항목만 추가하세요. JWT/OAuth/DB 값은 유지합니다.
# Compose가 dev,db 프로필을 지정합니다. 이 파일을 저장소에 두는 것만으로 서버에 적용되지는 않습니다.
# 변경 후 앱 컨테이너만 재생성해야 합니다. 단순 restart는 env_file 변경을 읽지 않습니다.
DB_URL=jdbc:mysql://mysql:3306/ontop_dev?connectionTimeZone=UTC
DB_USERNAME=ontop_dev
AUTH_JWT_SECRET_BASE64=REPLACE_WITH_DIFFERENT_BASE64_RANDOM_SECRET
AUTH_JWT_ISSUER=ontop-dev
AUTH_ALLOWED_ORIGINS=https://dev.on-top.world
AUTH_FRONTEND_CALLBACK_URI=https://dev.on-top.world/auth/callback
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
WEBSOCKET_AUTHENTICATED=true
BEHAVIOR_LOG_ENABLED=true
# 랭킹판 최초 DEV 배포 시각을 UTC ISO-8601로 정한 뒤 유지합니다. 빈 값이면 랭킹판 API는 503입니다.
PARK_RANKING_STARTED_AT=
# DEV keeps its configured single channel. Use a separate test configuration for dynamic-channel checks.
WORLD_DYNAMIC_CHANNELS_ENABLED=false

# 실제 경기 DB 스키마·예약/정산 연결 확인 후 게임 시작과 사용할 엔진을 함께 켜세요.
# 오목 연동 요청값: GAME_START_ENABLED=true / GAME_OMOK_ENABLED=true.
# 신규 서버 생성 시 자동 활성화를 피하기 위해 이 기본 템플릿은 false를 유지합니다.
GAME_START_ENABLED=false
GAME_OMOK_ENABLED=false
GAME_FARKLE_ENABLED=false
GAME_ONECARD_ENABLED=false
GAME_BRIDGE_ENABLED=false
GAME_LEDGER_ENABLED=false
# 알까기와 할리갈리는 application-dev.yml에서 기본으로 켜져 있어 여기서 값을 두지 않습니다.
# 각 줄을 false로 적으면 기본값보다 우선해 dev에서도 꺼집니다. 끌 때만 주석을 풀어 쓰세요.
# GAME_ALKKAGI_ENABLED=false
# GAME_HALLIGALLI_ENABLED=false
# 공통 미니게임은 dev 프로필에서 기본 활성입니다. 붕어빵 v5만 별도 opt-in입니다.
# FE가 v5로 빌드된 환경에서만 함께 true로 켭니다.
BUNGEOPPANG_V5_ENABLED=false
# 첫 주(2026-11-02 09:00 KST 시작) 게임상은 V153·검증 기록·관리자 ID 확인 후 켭니다.
MINIGAME_AWARD_ENABLED=false
# MINIGAME_AWARD_AUTO_ENABLED=true
# 첫 주 회차는 2026-11-02로 고정. 다음 주차는 관리자 API에서 게임·상품을 등록합니다.
# 둘째 주(2026-11-09 09:00 KST 시작) 엽전 보유량 상은 V154·관리자 ID 확인 후 켭니다.
ASSET_AWARD_ENABLED=false
# ASSET_AWARD_AUTO_ENABLED=true
# ASSET_AWARD_WEEK=2026-11-09

# 각 기능의 기존 DB 적용 이력·데이터 준비를 확인한 뒤 켭니다.
# 이 예제로 Flyway locations·버전·이력을 변경하지 않습니다.
SHOP_ENABLED=false
FEEDBACK_ENABLED=false
NOTES_ENABLED=false
# 익명 메모 활성화 시 전 인스턴스가 공유하는 32자 이상 별도 난수 비밀키가 필요합니다.
# 비밀키가 없거나 짧거나, V133 메모 테이블이 없는 DB에서 NOTES_ENABLED=true면 앱이 시작하지 않습니다.
# 비밀키는 이 파일 예제·저장소·명령 로그에 적지 않고 서버의 app.env에만 둡니다.
NOTES_PRIVACY_SECRET=
# 서버에서 확정한 관리자 내부 회원 ID. 지급 권한은 조회 권한과 별도로 부여합니다.
# 기존 FEEDBACK_ADMINISTRATOR_IDS를 쓰는 서버에 빈 ADMIN_READ_IDS를 추가하면 기존 권한이 가려집니다.
# 해당 서버는 ADMIN_READ_IDS를 미지정으로 유지하거나 기존 관리자 ID를 같은 값으로 옮기세요.
ADMIN_READ_IDS=
ADMIN_GRANT_IDS=
# 점검 전환 전용 관리자 ID. 생략하면 ADMIN_GRANT_IDS를 사용합니다.
# ADMIN_OPERATION_IDS=
# 원문 연락처를 볼 GM 내부 회원 ID. ADMIN_READ_IDS에도 포함해야 합니다.
ADMIN_CONTACT_IDS=
# V155 반영 및 키 설정 확인 후 켭니다. 키 원문은 서버 app.env에만 둡니다.
EVENT_CONTACT_ENABLED=false
EVENT_CONTACT_ACTIVE_KEY_ID=
# 형식: key-id=32바이트_Base64. 키 교체 시 이전 키도 쉼표로 이어서 보관합니다.
EVENT_CONTACT_KEYS=

# 기존 맵 유지. generated 맵 전환·맵 확인 강제는 FE 공동 검증 후 별도로 진행합니다.
WORLD_MAP_SOURCE=legacy
WORLD_MAP_JSON_PATH=
WORLD_MAP_MANIFEST_PATH=
WORLD_MAP_REQUIRE_MATCH=false
# 점프맵은 dev 프로필에서 기본 활성입니다(application-dev.yml). generated 맵과 코스 mapVersion이 같아야 켜집니다.
# QA를 멈출 때만 WORLD_JUMPMAP_ENABLED=false를 추가하세요.
WORLD_EMOTE_CODES=WAVE,CLAP,APPLAUSE_REQUEST,TSK,FART

# 기존 로그인 자격 증명·공급자에 등록한 콜백 주소를 유지합니다.
SSAFY_CLIENT_ID=REPLACE_WITH_DEV_CLIENT_ID
SSAFY_CLIENT_SECRET=REPLACE_WITH_DEV_CLIENT_SECRET
SSAFY_REDIRECT_URI=https://dev.on-top.world/api/v1/auth/ssafy/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
