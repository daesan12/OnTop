# Copy outside Git to /etc/ontop/dev-app/app.env (root:root, 0600).
# DB_PASSWORD is read from the same Compose secret used by dev MySQL.
DB_URL=jdbc:mysql://mysql:3306/ontop_dev?connectionTimeZone=UTC
DB_USERNAME=ontop_dev
AUTH_JWT_SECRET_BASE64=REPLACE_WITH_DIFFERENT_BASE64_RANDOM_SECRET
AUTH_JWT_ISSUER=ontop-dev
AUTH_ALLOWED_ORIGINS=https://dev.on-top.world
AUTH_FRONTEND_CALLBACK_URI=https://dev.on-top.world/auth/callback
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
WEBSOCKET_AUTHENTICATED=true
SSAFY_CLIENT_ID=REPLACE_WITH_DEV_CLIENT_ID
SSAFY_CLIENT_SECRET=REPLACE_WITH_DEV_CLIENT_SECRET
SSAFY_REDIRECT_URI=https://dev-api.on-top.world/api/v1/auth/ssafy/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
