# DEV and production use the same AI_ENABLED switch and existing DB connection.
# Add to the existing backend app env; never replace existing DB/auth/admin settings.
AI_ENABLED=false
AI_JEV_ENABLED=true
JEV_API_KEY=REPLACE_WITH_SECRET
JEV_MODEL=jev-1.14.0
AI_MM_ENABLED=false
AI_MM_WEBHOOK=REPLACE_WITH_FULL_INCOMING_WEBHOOK_URL
AI_POLICE_ENABLED=true
AI_RESIDENTS_ENABLED=true
# Optional OS-compatible Rapfi executable; empty uses the built-in tactical opponent.
AI_RAPFI_PATH=
OPENAI_API_KEY=
AI_LLM_MODEL=gpt-4.1-mini
# NPC/feedback text only; this is not a global API billing cap.
AI_LLM_DAILY_CALLS=100

# 아재왕: Jev 공개 검수 + OpenAI 통합 채점/리액션, DB V170
AI_JOKE_ENABLED=false
# 아재왕 전용 모델. 위 AI_LLM_MODEL은 NPC/소리함용으로 유지합니다.
AI_JOKE_LLM_MODEL=gpt-5.4-mini
# 문제 원문/모델 응답 진단 로그는 필요할 때만 일시 활성화합니다.
AI_JOKE_DIAGNOSTICS_ENABLED=false
