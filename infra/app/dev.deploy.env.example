# Copy outside Git to /etc/ontop/dev-app/deploy.env (root:root, 0600).
# Paths must be absolute and must exist before docker compose up.
APP_ENV_FILE=/etc/ontop/dev-app/app.env
DEV_MYSQL_ROOT_PASSWORD_FILE=/etc/ontop/dev-app/secrets/mysql-root-password
DEV_MYSQL_APP_PASSWORD_FILE=/etc/ontop/dev-app/secrets/mysql-app-password
NGINX_CONFIG_FILE=/opt/ontop/infra/app/nginx/bootstrap.conf
ACME_WEBROOT_DIR=/srv/ontop/dev-app/acme
TLS_DIR=/etc/ontop/dev-app/tls
# Docker Hub private repository. Replace manual with the image's immutable release tag.
BACKEND_IMAGE=wooaw/ontop-backend:manual
