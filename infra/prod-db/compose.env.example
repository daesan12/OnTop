# Copy to /etc/ontop/prod-db/compose.env on PROD-DB. This file has no passwords.
DB_WG_IP=10.77.0.1
DB_DATA_DIR=/srv/ontop/mysql
DB_ROOT_PASSWORD_FILE=/etc/ontop/prod-db/secrets/mysql-root-password
DB_APP_PASSWORD_FILE=/etc/ontop/prod-db/secrets/mysql-app-password
BACKUP_S3_URI=s3://REPLACE_WITH_PRIVATE_BUCKET/ontop/prod-db
