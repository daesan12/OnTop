{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["ontop/prod-db/", "ontop/prod-db/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteBackupObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/ontop/prod-db/*"
    }
  ]
}
