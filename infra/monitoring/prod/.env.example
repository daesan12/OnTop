# PROD server only. Keep the populated file outside Git.
PROD_APP_NETWORK=ontop-prod-app_default
PROMETHEUS_PORT=9090
# Dedicated read-only PROD metrics account. Do not reuse the application or root account.
MYSQL_EXPORTER_CONFIG_FILE=/etc/ontop/monitor-prod/secrets/mysql-exporter.cnf
# Installed checkout path on PROD-APP. Keep it explicit instead of assuming /opt/ontop.
PROD_MONITORING_NGINX_CONFIG_FILE=/opt/ontop/infra/monitoring/prod/nginx.tls.conf
